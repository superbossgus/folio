# Panel de Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...

# NUNCA con el prefijo NEXT_PUBLIC_. Solo servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# Correo saliente (resend.com). Sin esto el sistema sigue funcionando:
# la liga se copia a mano en lugar de mandarse sola.
RESEND_API_KEY=re_...
CORREO_REMITENTE="Folio · Tu Empresa <expedientes@tuempresa.mx>"

# Dirección pública del sistema. Va dentro del correo que llega al banco,
# así que debe ser la real, no la que reporte el proxy.
NEXT_PUBLIC_URL_BASE=https://folio.tuempresa.mx

# Autentica al servicio de revisión de archivos
WEBHOOK_ANTIVIRUS_SECRET=una-cadena-larga-y-aleatoria
